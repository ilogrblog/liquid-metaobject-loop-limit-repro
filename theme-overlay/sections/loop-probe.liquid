{%- assign split_seen = 0 -%}
{%- for s in split_items -%}
  {%- assign split_seen = split_seen | plus: 1 -%}
{%- endfor -%}

{%- assign range_seen = 0 -%}
{%- for n in (1..1300) -%}
  {%- assign range_seen = range_seen | plus: 1 -%}
{%- endfor -%}

{%- assign paged = 0 -%}
{%- paginate defn.values by section.settings.page_size -%}
  {%- for item in defn.values -%}
    {%- assign paged = paged | plus: 1 -%}
  {%- endfor -%}
  <pre id="probe-{{ section.id }}">PROBE section={{ section.id }} type={{ section.settings.definition_type }} page_size={{ section.settings.page_size }} values_count={{ defn.values_count | json }} plain_loop={{ plain }} paginated_loop={{ paged }} pages={{ paginate.pages }} current_page={{ paginate.current_page }} page_param={{ paginate.page_param | json }} split_1300={{ split_seen }} range_1300={{ range_seen }}</pre>
{%- endpaginate -%}

{% schema %}
{
  "name": "Loop-limit probe",
  "settings": [
    { "type": "text", "id": "definition_type", "label": "Metaobject definition type", "default": "repro_item" },
    { "type": "number", "id": "page_size", "label": "Page size", "default": 250 }
  ],
  "presets": [{ "name": "Loop-limit probe" }]
}
{% endschema %}
