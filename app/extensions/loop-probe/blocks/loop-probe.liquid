{%- comment -%}
  Loop-limit probe. Reads one metaobject definition and prints plain-text counts.
  Read-only: it writes nothing.
{%- endcomment -%}
{%- assign defn = metaobjects['$app:repro_entry'] -%}

{%- assign plain = 0 -%}
{%- for item in defn.values -%}
  {%- assign plain = plain | plus: 1 -%}
{%- endfor -%}

