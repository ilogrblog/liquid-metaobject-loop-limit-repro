{%- assign split_seen = 0 -%}
{%- for s in split_items -%}
  {%- assign split_seen = split_seen | plus: 1 -%}
{%- endfor -%}

{%- assign range_seen = 0 -%}
{%- for n in (1..1300) -%}
  {%- assign range_seen = range_seen | plus: 1 -%}
{%- endfor -%}

{%- assign paged = 0 -%}
{%- paginate defn.values by block.settings.page_size -%}
  {%- for item in defn.values -%}
    {%- assign paged = paged | plus: 1 -%}
  {%- endfor -%}
  <pre id="probe-{{ block.id }}">PROBE block={{ block.id }} type=$app:repro_entry page_size={{ block.settings.page_size }} values_count={{ defn.values_count | json }} plain_loop={{ plain }} paginated_loop={{ paged }} pages={{ paginate.pages }} current_page={{ paginate.current_page }} page_param={{ paginate.page_param | json }} split_1300={{ split_seen }} range_1300={{ range_seen }}</pre>
{%- endpaginate -%}

{% schema %}
{
  "name": "Loop-limit probe",
  "target": "section",
  "settings": [
    { "type": "number", "id": "page_size", "label": "Page size", "default": 250 }
  ]
}
{% endschema %}
