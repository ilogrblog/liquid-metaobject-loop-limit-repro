# Copy to shopify.app.toml after creating your own app, and replace the client_id.
client_id = "REPLACE_WITH_YOUR_APP_CLIENT_ID"
name = "loop-limit-repro"
application_url = "https://example.com"
embedded = false

[access_scopes]
scopes = "write_metaobject_definitions,write_metaobjects"

[auth]
redirect_urls = ["https://example.com/auth/callback"]

[webhooks]
api_version = "2026-10"

[metaobjects.app.repro_entry]
name = "Loop limit repro entry"
display_name_field = "title"

[metaobjects.app.repro_entry.access]
storefront = "public_read"

[metaobjects.app.repro_entry.fields.title]
name = "Title"
type = "single_line_text_field"
